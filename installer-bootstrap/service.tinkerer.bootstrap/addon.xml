<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.tinkerer.bootstrap" name="Tinkerer Add-on Bootstrap" version="1.0.0" provider-name="Tinkerer">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.service" library="bootstrap.py" start="startup" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en">Initialises the private Tinkerer add-ons.</summary>
    <description lang="en">One-time installer helper for the portable Kodi build.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
